{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(python3 -I -m unittest *)",
      "Bash(python -I -m unittest *)",
      "Bash(/usr/bin/python3 -I -m unittest *)",
      "Bash(python3 -I skills/team-logbook/scripts/day.py *)",
      "Bash(python -I skills/team-logbook/scripts/day.py *)"
    ],
    "ask": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.py\"; [ -f \"$g\" ] || exit 0; for p in python3 python py; do \"$p\" -c '' 2>/dev/null && exec \"$p\" -I \"$g\"; done; exit 0",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
